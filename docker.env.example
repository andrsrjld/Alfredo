# Copy to .env on the server before running docker compose.
# Keep .env private. It contains service-role and provider secrets.

ALFREDO_PORT=3000
NEXT_PUBLIC_APP_URL=https://alfredo.example.com

# Supabase managed project. Safe to keep using Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption key for API keys stored in app_settings.
# Must stay the same as the current production value or stored API keys must be re-saved.
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# Webhook/security secrets.
WA_WEBHOOK_SECRET=your_whatsapp_webhook_secret
WA_WEBHOOK_VERIFY_TOKEN=alfredo_webhook_verify_token
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret
GITLAB_WEBHOOK_SIGNING_TOKEN=
SERVER_PING_SECRET=your_server_ping_secret
CRON_SECRET=random-hex-32-bytes

# Messaging provider: meta, fonnte, or evolution.
WA_PROVIDER=fonnte
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_ACCESS_TOKEN=your_whatsapp_access_token
WA_APP_SECRET=
FONNTE_API_KEY=your_fonnte_api_key
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=your_instance_name

# AI provider defaults. Dashboard settings can override these.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
AI_TEMPERATURE=0.0
SEARCH_MIN_CONFIDENCE=0.72

# Bot config.
BOT_ACTIVE_START=03:00
BOT_ACTIVE_END=12:00
BOT_TIMEZONE=Asia/Jakarta

# Monitoring cadence. Lower values update faster but create more traffic.
SERVER_PING_INTERVAL_SECONDS=60
CONTAINER_PING_INTERVAL_SECONDS=300
STALE_THRESHOLD_SECONDS=180
